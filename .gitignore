# data: never commit raw images or tiles
data/
!data/**/.gitkeep
*.tif
*.tiff

# secrets and local config
.env
.env.*
.modal.toml
*.pem
.devin/mcp_config.local.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# large artefacts
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.parquet
!results/**/*.parquet
weights/

# os / editors
.DS_Store
.vscode/
.idea/

# Cottrell local web application
frontend/node_modules/
frontend/dist/
app/local_uploads/
app/local_reviews/
.cottrell/
.impeccable/review/

frontend/*.tsbuildinfo

# Hosted Sites build
/dist/
/node_modules/
.sites-runtime/

# Saved training micrograph display copies stay in private app storage.
results/v1/validation_previews/*.png
